<Window x:Class="Drively.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Drively.App.ViewModels"
        xmlns:svc="clr-namespace:Drively.App.Services"
        Title="DRIVELY" Width="1240" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/drively.ico"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,22">
                    <TextBlock Text="DRIVELY" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Open-source driver manager" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,12,20,20">
                    <Border Style="{StaticResource NoticeCard}" Margin="0,0,0,12"
                            Visibility="{Binding Environment.IsDemoMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="Demo mode: simulated hardware and updates. Nothing is installed." />
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="{StaticResource Icon.Shield}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ElevationText}" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                    <Button Content="Restart as administrator" Margin="0,8,0,0" HorizontalAlignment="Left" FontSize="12"
                            Command="{Binding RestartAsAdministratorCommand}"
                            Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                            ToolTip="Installing, backing up and restoring drivers require administrator permissions." />
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Content="Dashboard" Tag="{StaticResource Icon.Home}"
                                 Checked="OnNavigationChecked" CommandParameter="{x:Static svc:PageKey.Dashboard}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Dashboard}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Drivers" Tag="{StaticResource Icon.Drivers}"
                                 Checked="OnNavigationChecked" CommandParameter="{x:Static svc:PageKey.Drivers}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Drivers}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Backup &amp; Restore" Tag="{StaticResource Icon.Backup}"
                                 Checked="OnNavigationChecked" CommandParameter="{x:Static svc:PageKey.Backup}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Backup}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="History" Tag="{StaticResource Icon.History}"
                                 Checked="OnNavigationChecked" CommandParameter="{x:Static svc:PageKey.History}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=History}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Settings" Tag="{StaticResource Icon.Settings}"
                                 Checked="OnNavigationChecked" CommandParameter="{x:Static svc:PageKey.Settings}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="32,26,32,24" Focusable="False" />
    </Grid>
</Window>

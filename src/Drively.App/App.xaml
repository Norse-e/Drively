<Application x:Class="Drively.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Drively.App.ViewModels"
             xmlns:views="clr-namespace:Drively.App.Views"
             xmlns:c="clr-namespace:Drively.App.Components"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is swapped at runtime by ThemeService. -->
                <ResourceDictionary Source="Resources/Theme.Light.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <c:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <c:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
            <c:EqualsConverter x:Key="Equals" />

            <Style TargetType="c:StatCard">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="c:StatCard">
                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="14,12" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{TemplateBinding Label}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{TemplateBinding Value}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"
                                               Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock Text="{TemplateBinding Caption}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Style>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriversViewModel}"><views:DriversView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupViewModel}"><views:BackupView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

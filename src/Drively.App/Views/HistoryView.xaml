<UserControl x:Class="Drively.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Text="History" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Driver downloads, installations, backups and restorations performed with DRIVELY. Stored only on this PC." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Refresh" Margin="0,0,8,0" Command="{Binding LoadCommand}" />
                <Button Content="Clear history" Style="{StaticResource DangerButton}" Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Foreground="{DynamicResource Brush.Danger}" Margin="0,0,0,8"
                   Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVisibility}}" />
        <Grid>
            <TextBlock Text="No driver operations have been recorded yet." Style="{StaticResource Muted}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <DataGrid ItemsSource="{Binding Entries}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding TimestampText}" Width="Auto" />
                    <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="Auto" />
                    <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="2*" />
                    <DataGridTextColumn Header="Driver version" Binding="{Binding DriverVersion}" Width="*" />
                    <DataGridTemplateColumn Header="Result" Width="Auto" SortMemberPath="Result">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Result}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="Cancelled">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>

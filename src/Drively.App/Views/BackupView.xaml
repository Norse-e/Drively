<UserControl x:Class="Drively.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Backup &amp; Restore" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Export your third-party drivers with the built-in Windows PnPUtil tool and restore them later." />

            <Border Style="{StaticResource NoticeCard}" Margin="0,0,0,14">
                <TextBlock TextWrapping="Wrap"
                           Text="A driver backup is not a complete system image. It does not guarantee recovery from every hardware or Windows problem. Drivers included with Windows are not exported because Windows restores them itself." />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Create a backup" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Create backup" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Command="{Binding CreateBackupCommand}" />
                        <Button DockPanel.Dock="Right" Content="Change…" Margin="8,0,0,0" Command="{Binding ChangeDirectoryCommand}" />
                        <TextBox Text="{Binding BackupDirectory, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                               Text="Requires administrator permissions. Drivers are copied; nothing on your PC is changed." />
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Backup list -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Open…" Command="{Binding OpenOtherBackupCommand}" Padding="10,4"
                                ToolTip="Open a DRIVELY backup from another folder or drive." />
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshBackupsCommand}" Padding="10,4" Margin="0,0,6,0" />
                        <TextBlock Text="Backups" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <TextBlock Text="No backups found in the backup directory." Style="{StaticResource Muted}"
                                   Visibility="{Binding Backups.Count, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CreatedText}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                            <Run Text="{Binding ExportedCount, Mode=OneWay}" /><Run Text=" drivers · " /><Run Text="{Binding Manifest.ComputerModel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Contents -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Open folder" Command="{Binding OpenBackupFolderCommand}" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteBackupCommand}" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Restore selected…" Style="{StaticResource PrimaryButton}" Command="{Binding RestoreSelectedCommand}" Padding="10,4" />
                        </StackPanel>
                        <TextBlock Text="Backup contents" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding HasSelectedBackup, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource LinkButton}" Content="Select all" Command="{Binding SelectAllCommand}" CommandParameter="all" Margin="0,0,14,0" />
                        <Button Style="{StaticResource LinkButton}" Content="Select none" Command="{Binding SelectAllCommand}" CommandParameter="none" />
                    </StackPanel>
                    <Grid>
                        <TextBlock Text="Select a backup to view its contents." Style="{StaticResource Muted}"
                                   Visibility="{Binding HasSelectedBackup, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <DataGrid ItemsSource="{Binding Entries}" Visibility="{Binding HasSelectedBackup, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Entry.Exported}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Devices" Binding="{Binding Entry.DeviceNamesText}" Width="2*" />
                                <DataGridTextColumn Header="Provider" Binding="{Binding Entry.Provider}" Width="*" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Entry.Version}" Width="Auto" />
                                <DataGridTextColumn Header="INF" Binding="{Binding Entry.OriginalInf}" Width="Auto" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Entry.Error, TargetNullValue='Exported'}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

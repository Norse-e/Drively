<Window x:Class="Drively.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Brush.Surface}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}">
    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" MinWidth="110" IsDefault="True" Click="OnConfirm" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextSecondary}" />

                <Border x:Name="DetailsPanel" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
                    <ItemsControl x:Name="DetailsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border x:Name="WarningPanel" Style="{StaticResource NoticeCard}" Margin="0,14,0,0">
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

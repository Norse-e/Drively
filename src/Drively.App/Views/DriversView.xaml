<UserControl x:Class="Drively.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Drively.App.Components">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Text="Drivers" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,4"
                           Text="Installed hardware and drivers detected on this PC, and verified driver updates." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Export CSV" Margin="0,0,8,0" Command="{Binding ExportCsvCommand}"
                        IsEnabled="{Binding Session.HasScan}" ToolTip="Save the driver inventory as a CSV file." />
                <Button Content="Export JSON" Margin="0,0,8,0" Command="{Binding ExportJsonCommand}"
                        IsEnabled="{Binding Session.HasScan}" ToolTip="Save the driver inventory as a JSON file." />
                <Button Content="Rescan" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                        IsEnabled="{Binding Session.IsBusy, Converter={x:Static c:InverseBool.Instance}}" />
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
            <ProgressBar IsIndeterminate="{Binding Session.IsBusy}" Visibility="{Binding Session.IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Session.StatusMessage}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                       Visibility="{Binding Session.IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="0,8,0,0">
            <!-- Installed drivers -->
            <TabItem Header="Installed drivers">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="400" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>

                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{Binding CountText}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Grid.Column="2">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     AutomationProperties.Name="Search devices" />
                            <TextBlock Text="Search by device, provider or hardware ID" IsHitTestVisible="False" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice}">
                            <DataGrid.Resources>
                                <Style x:Key="Trim" TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="2*" MinWidth="120" ElementStyle="{StaticResource Trim}" />
                                <DataGridTextColumn Header="Provider" Binding="{Binding DriverProviderText}" Width="*" MinWidth="70" ElementStyle="{StaticResource Trim}" />
                                <DataGridTextColumn Header="Version" Binding="{Binding DriverVersionText}" Width="100" ElementStyle="{StaticResource Trim}" />
                                <DataGridTemplateColumn Header="Status" Width="104" SortMemberPath="StateName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <c:StatePill />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Details -->
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <Grid>
                            <TextBlock Text="Select a device to see its driver details." Style="{StaticResource Muted}"
                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel DataContext="{Binding SelectedDevice}">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <c:StatePill Margin="0,8,0,4" />
                                    <TextBlock Text="{Binding ProblemDescription}" Style="{StaticResource Muted}" Margin="0,0,0,12" />

                                    <TextBlock Text="Device" Style="{StaticResource SectionTitle}" Margin="0,4,0,6" />
                                    <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}" Margin="0" />
                                    <TextBlock Text="{Binding Manufacturer, TargetNullValue='—'}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Text="Category / class" Style="{StaticResource FieldLabel}" Margin="0" />
                                    <TextBlock Style="{StaticResource FieldValue}">
                                        <Run Text="{Binding CategoryName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DeviceClass, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="Hardware ID" Style="{StaticResource FieldLabel}" Margin="0" />
                                    <TextBox Text="{Binding PrimaryHardwareId, Mode=OneWay}" Style="{StaticResource SelectableText}" />

                                    <TextBlock Text="Driver" Style="{StaticResource SectionTitle}" Margin="0,10,0,6" />
                                    <TextBlock Text="No driver is installed for this device." Style="{StaticResource Muted}" Margin="0,0,0,6"
                                               Visibility="{Binding HasDriver, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    <StackPanel Visibility="{Binding HasDriver, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Provider" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <TextBlock Text="{Binding DriverProviderText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Text="Version" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <TextBlock Text="{Binding DriverVersionText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Text="Date" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <TextBlock Text="{Binding DriverDateText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Text="INF" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <TextBlock Text="{Binding Driver.InfName}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Text="Signer" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <TextBlock Text="{Binding Driver.Signer, TargetNullValue='Not reported'}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <TextBlock Text="Instance ID" Style="{StaticResource FieldLabel}" Margin="0" />
                                    <TextBox Text="{Binding InstanceId, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="11" />

                                    <TextBlock Text="Official support" Style="{StaticResource SectionTitle}" Margin="0,10,0,6" />
                                    <ItemsControl ItemsSource="{Binding DataContext.SelectedDeviceLinks, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <Button Style="{StaticResource LinkButton}" Content="{Binding Title}" ToolTip="{Binding Url}"
                                                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Updates -->
            <TabItem Header="{Binding UpdatesHeader}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource InfoCard}" Margin="0,0,0,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Check for updates" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding CheckForUpdatesCommand}"
                                    IsEnabled="{Binding Session.IsBusy, Converter={x:Static c:InverseBool.Instance}}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdatesMessage}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RejectedText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                                           Visibility="{Binding RejectedText, Converter={StaticResource NotEmptyToVisibility}}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Source: Microsoft Windows Update. An update is shown only if its hardware ID matches a device on this PC and its version is newer than the installed one. For other drivers, use the official support links on each device." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Style="{StaticResource NoticeCard}" Margin="0,0,0,12"
                            Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Downloading and installing drivers requires administrator permissions. You will be asked to restart DRIVELY as administrator." />
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Updates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Update.DeviceName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Update.Title}" Style="{StaticResource Muted}" Margin="0,2,0,12" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Current version" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Update.CurrentVersion}" Style="{StaticResource FieldValue}" />
                                                <TextBlock Grid.Column="2" Text="New version" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Update.NewVersion}" Style="{StaticResource FieldValue}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1" Text="Driver provider" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Update.Provider}" Style="{StaticResource FieldValue}" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Driver date" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Update.NewDriverDateText}" Style="{StaticResource FieldValue}" />
                                                <TextBlock Grid.Row="2" Text="Download source" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Update.Source}" Style="{StaticResource FieldValue}" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Download size" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Update.SizeText}" Style="{StaticResource FieldValue}" />
                                                <TextBlock Grid.Row="3" Text="Signature" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Update.SignatureStatus}" Style="{StaticResource FieldValue}" />
                                            </Grid>
                                            <Border Style="{StaticResource NoticeCard}" Margin="0,6,0,0" Padding="10,6"
                                                    Visibility="{Binding Update.ProviderChangeText, Converter={StaticResource NotEmptyToVisibility}}">
                                                <TextBlock Text="{Binding Update.ProviderChangeText}" TextWrapping="Wrap" FontSize="12" />
                                            </Border>
                                            <DockPanel Margin="0,10,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="Download" Margin="0,0,8,0" Command="{Binding DownloadCommand}" />
                                                    <Button Content="Download &amp; Install" Style="{StaticResource PrimaryButton}" Command="{Binding DownloadAndInstallCommand}" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                                                 Margin="0,0,16,6" />
                                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,16,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

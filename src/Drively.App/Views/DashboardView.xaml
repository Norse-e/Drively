<UserControl x:Class="Drively.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Drively.App.Components">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Everything shown here comes from this PC's actual hardware detection. Nothing is estimated." />

            <!-- Actions -->
            <WrapPanel Margin="0,0,0,12">
                <Button Style="{StaticResource PrimaryButton}" Content="Scan for drivers" Margin="0,0,8,8" Command="{Binding ScanCommand}"
                        IsEnabled="{Binding Session.IsBusy, Converter={x:Static c:InverseBool.Instance}}" />
                <Button Content="Check for updates" Margin="0,0,8,8" Command="{Binding CheckForUpdatesCommand}"
                        IsEnabled="{Binding Session.IsBusy, Converter={x:Static c:InverseBool.Instance}}"
                        ToolTip="Contacts Microsoft Windows Update to look for driver updates for this PC." />
                <Button Content="View available updates" Margin="0,0,8,8" Command="{Binding ViewUpdatesCommand}" />
            </WrapPanel>

            <!-- Progress -->
            <StackPanel Margin="0,0,0,16">
                <ProgressBar IsIndeterminate="{Binding Session.IsBusy}" Visibility="{Binding Session.IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Session.StatusMessage}" Style="{StaticResource Muted}" />
            </StackPanel>

            <Border Style="{StaticResource NoticeCard}" Margin="0,0,0,16"
                    Visibility="{Binding Session.ScanError, Converter={StaticResource NotEmptyToVisibility}}">
                <TextBlock Text="{Binding Session.ScanError}" TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <!-- System info -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="System information" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Windows" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding Session.System.WindowsVersion, FallbackValue='—'}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="1" Text="Build" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Session.System.WindowsBuild, FallbackValue='—'}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="2" Text="Architecture" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Session.System.Architecture, FallbackValue='—'}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="3" Text="Manufacturer" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Session.System.Manufacturer, FallbackValue='—'}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="4" Text="Model" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Session.System.Model, FallbackValue='—'}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="5" Text="Last scan" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastScanText}" Style="{StaticResource FieldValue}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Overview -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,18,8,8" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Driver overview" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="3">
                            <c:StatCard Label="Detected devices" Value="{Binding TotalDevices}" Caption="Plug and Play devices" />
                            <c:StatCard Label="Installed drivers" Value="{Binding InstalledDrivers}" Caption="Devices with a driver" />
                            <c:StatCard Label="Updates available" Value="{Binding UpdatesAvailable}" Caption="{Binding UpdatesCaption}"
                                        Foreground="{DynamicResource Brush.Accent}" />
                            <c:StatCard Label="Driver problems" Value="{Binding ProblemDevices}" Caption="Devices reporting errors"
                                        Foreground="{DynamicResource Brush.Danger}" />
                            <c:StatCard Label="Missing drivers" Value="{Binding MissingDrivers}" Caption="No driver installed"
                                        Foreground="{DynamicResource Brush.Warning}" />
                        </UniformGrid>
                        <Button Style="{StaticResource LinkButton}" Content="Show devices with problems" Margin="0,2,0,10"
                                Command="{Binding ViewProblemsCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource InfoCard}" Margin="0,16,0,0"
                    Visibility="{Binding UpdateMessage, Converter={StaticResource NotEmptyToVisibility}}">
                <TextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"
                       Text="Privacy: scans run locally. DRIVELY contacts Microsoft Windows Update only when you check for, download or install updates. No accounts, no tracking." />
        </StackPanel>
    </ScrollViewer>
</UserControl>

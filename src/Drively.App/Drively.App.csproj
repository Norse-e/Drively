<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Drively</AssemblyName>
    <RootNamespace>Drively.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\drively.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Description>DRIVELY — free, open-source Windows driver manager.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Resource Include="Resources\drively.ico" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Link="THIRD-PARTY-NOTICES.md" />
    <None Include="..\..\LICENSE" CopyToOutputDirectory="PreserveNewest" Link="LICENSE" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Drively.Core\Drively.Core.csproj" />
    <ProjectReference Include="..\Drively.DriverDetection\Drively.DriverDetection.csproj" />
    <ProjectReference Include="..\Drively.DriverUpdates\Drively.DriverUpdates.csproj" />
    <ProjectReference Include="..\Drively.DriverInstallation\Drively.DriverInstallation.csproj" />
    <ProjectReference Include="..\Drively.Backup\Drively.Backup.csproj" />
    <ProjectReference Include="..\Drively.Data\Drively.Data.csproj" />
  </ItemGroup>
</Project>
